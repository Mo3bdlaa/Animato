<?xml version="1.0" encoding="utf-8"?>
<!--
  Screens, and the one activity among them the system has to be able to find by name.

  Everything else this module navigates to is declared by :anime:player.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
          "Search Frieren on Animato", said to the Assistant, and text shared here to look for.

          Mihon declares the same three filters for its own DeepLinkActivity, so both appear in the
          chooser and their labels are what tell them apart — Aniyomi's arrangement, and the reason
          this one is labelled Global Anime Search rather than Search.

          It draws nothing. It stamps the intent with its DeepLinkScreenType and hands it to the
          main activity, which is the only place that knows how to route it; NoDisplay is what keeps
          that pass-through invisible.
        -->
        <activity
            android:name="eu.kanade.tachiyomi.ui.deeplink.anime.DeepLinkAnimeActivity"
            android:exported="true"
            android:label="@string/action_global_anime_search"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="eu.kanade.tachiyomi.ANIMESEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Where a tracker's sign-in page sends the browser back to.

          Only for trackers Mihon does not have — its own TrackLoginActivity answers for the rest,
          under `mihon://`, and the five wrapping trackers sign in through it because they share its
          credentials.

          The scheme is `aniyomi` and not ours because Simkl only redirects to the address its
          client id is registered with, and that id is Aniyomi's. SimklApi has the full reasoning,
          and what it costs: on a phone with Aniyomi also installed, the system asks which app
          should handle the link.
        -->
        <activity
            android:name="animato.anime.ui.track.AnimeTrackLoginActivity"
            android:exported="true"
            android:label="@string/track_activity_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Tachiyomi">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="aniyomi" />

                <data android:host="simkl-auth" />
            </intent-filter>
        </activity>

    </application>

</manifest>
