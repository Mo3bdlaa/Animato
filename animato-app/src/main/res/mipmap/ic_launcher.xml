<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides Mihon's launcher icon by resource name. The application module wins resource merging
  over its library dependencies, so this replaces theirs without touching a file of theirs, and
  without a tools:replace on the manifest — Mihon's manifest still points at @mipmap/ic_launcher,
  which now resolves here.

  The foreground is the dragon mark on transparency, scaled so its ring sits inside the 66dp circle
  every launcher shows; any larger and a circular mask takes the dragon's head off. The background is
  flat ink black, which is what the mark is drawn for. Both layers and the monochrome one are built
  by docs/branding/build-icon.py from docs/branding/logo.png.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/animato_ink_black" />
    <foreground android:drawable="@drawable/animato_icon_foreground" />
    <monochrome android:drawable="@drawable/animato_icon_monochrome" />
</adaptive-icon>
