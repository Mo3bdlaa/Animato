<?xml version="1.0" encoding="utf-8"?>
<!--
  The application module contributes the entry point and the Injekt bootstrap. Everything else —
  Mihon's App and its other activities, and the anime components declared by :anime:services —
  arrives through manifest merging. See ARCHITECTURE.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Installable on a television.

      Both are `required="false"`, and that is the whole of it: the lines widen what the app runs on
      rather than narrowing it. Android assumes an app needs a touchscreen unless told otherwise, and
      a device without one then filters it out — so a TV refuses to install this without the second
      line, and the first is what lets a TV launcher list it at all.

      This is the declaration half of Android TV support, and it is only that. What a remote still
      cannot do is drive the screens: focus order, focus that is visible from three metres away, and
      a player whose controls can be reached without a finger. That work is deliberately not here —
      ROADMAP.md says why.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      A television launcher draws a banner rather than an icon: one flat 320×180 tile, with no
      adaptive layers and no mask. Without one the app installs and then cannot be found on the home
      screen, which is a worse failure than looking wrong. Built by docs/branding/build-tv-banner.py
      from the same artwork as the launcher icon.
    -->
    <application android:banner="@drawable/animato_tv_banner">

        <!--
          Animato's entry point.

          Mihon's colour scheme cannot be extended from another module, so the palette has to be
          applied above its screens rather than registered inside its theme — which means owning the
          root composable, which means owning this activity. MainActivity.kt has the full reasoning.

          The intent filters are Mihon's, carried across verbatim, because our activity now answers
          for all of them. `Theme.Tachiyomi.SplashScreen` is Mihon's style, and reusing it is
          correct: it draws `@color/splash` and `@drawable/ic_mihon_splash`, both of which this
          module already overrides with Animato's, so the launch window is ours without a new style.
        -->
        <activity
            android:name="animato.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Tachiyomi.SplashScreen">
            <!--
              LEANBACK_LAUNCHER is what a television home screen actually queries; LAUNCHER alone is
              invisible to it. Both categories sit on one filter rather than two, so a phone and a
              TV start the same activity and there is no second entry point to keep in step.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Legacy deeplink to add extension store -->
            <intent-filter android:label="@string/action_addExtensionStore">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="tachiyomi" />
                <data android:host="add-repo" />
            </intent-filter>

            <!-- Deeplink to add extension store -->
            <intent-filter android:label="@string/action_addExtensionStore">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="mihon" />
                <data android:host="extension-store" />
            </intent-filter>

            <!-- Open backup files -->
            <intent-filter android:label="@string/pref_restore_backup">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <!--
                Work around Android's ugly primitive PatternMatcher implementation that can't cope
                with finding a . early in the path unless it's explicitly matched.
                See https://stackoverflow.com/a/31028507
                -->
                <data android:pathPattern=".*\\.tachibk" />
                <data android:pathPattern=".*\\..*\\.tachibk" />
                <data android:pathPattern=".*\\..*\\..*\\.tachibk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.tachibk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.tachibk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.tachibk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.tachibk" />
            </intent-filter>

            <!--
              Launcher long-press shortcuts are declared on the launcher activity, so they move with
              it. Their intents still name Mihon's class, which the alias below resolves.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Mihon's entry point stops being one. This is a directive in our manifest, not an edit to
          theirs: the class stays exactly as it is, it simply stops being declared.
        -->
        <activity
            android:name="eu.kanade.tachiyomi.ui.main.MainActivity"
            tools:node="remove" />

        <!--
          …and its name is re-pointed at ours.

          Nine places name `eu.kanade.tachiyomi.ui.main.MainActivity` as an explicit component and
          are not ours to change: eight `Intent(context, MainActivity::class.java)` constructions
          across Mihon's notifications, deep links, reader, OAuth callback and crash handler, plus
          every `<intent android:targetClass>` in `@xml/shortcuts`. Removing the activity outright
          would turn all of them into ActivityNotFoundException.

          An alias is resolved by component *name*, and nothing requires that name to match a class.
          So the name Mihon's code asks for keeps resolving, and it resolves to our activity with
          the action and extras intact — which is exactly what MainActivity.handleIntentAction
          expects, since it reads Mihon's own constants.

          No intent-filter here on purpose: an alias carrying a LAUNCHER filter would put a second
          icon in the launcher. Not exported, because every caller is inside this app — a
          PendingIntent the system fires on our behalf does not need it, and nor does startActivity
          from our own process.
        -->
        <activity-alias
            android:name="eu.kanade.tachiyomi.ui.main.MainActivity"
            android:exported="false"
            android:targetActivity="animato.app.MainActivity" />

        <!--
          A hook, not a provider: it is created during application bind, which is what lets it
          schedule the anime Injekt registration for the moment after Mihon's App.onCreate has
          replaced the global scope. AnimeInjektInitializer explains the ordering.
        -->
        <provider
            android:name="animato.di.AnimeInjektInitializer"
            android:authorities="${applicationId}.animeinjekt"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
