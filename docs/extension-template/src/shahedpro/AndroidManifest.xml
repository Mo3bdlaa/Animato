<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        This declaration is what makes the APK an extension.

        Animato's loader scans installed packages for it and ignores everything else - the package
        name is only a convention, the feature is the actual filter. See
        AnimeExtensionLoader.EXTENSION_FEATURE.
    -->
    <uses-feature
        android:name="tachiyomi.animeextension"
        android:required="true" />

    <!--
        The name Animato and the store listing show, generated from extName in build.gradle.kts.

        It is a string resource rather than a literal on purpose: aapt only reports a label it can
        resolve, so an inline one leaves the published index naming this after its package. The
        note beside resValue in build.gradle.kts has the detail.
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <!--
            Where the source class is, relative to the package when it starts with a dot.

            Use `tachiyomi.animeextension.factory` instead of `.class` if one APK should provide
            several sources - it then points at a class implementing AnimeSourceFactory.
        -->
        <meta-data
            android:name="tachiyomi.animeextension.class"
            android:value=".ShahedProSource" />

        <!--
            Whether this source carries adult content. Animato hides NSFW sources by default and
            marks them incognito, so answering honestly is what makes those settings work.
        -->
        <meta-data
            android:name="tachiyomi.animeextension.nsfw"
            android:value="0" />

        <!--
            There is deliberately no `tachiyomi.animeextension.lib` entry here.

            It is the natural place to declare which extension API this was built against, and it
            is what most guides tell you to write, but nothing in Animato reads it - the loader
            derives the API version from the version *name* instead (see AnimeExtensionLoader, and
            the note beside versionName in build.gradle.kts). An extension that declares 14 here
            and leaves the version name at 1.0.x is rejected, silently, by an app that never looked
            at this line.
        -->

    </application>
</manifest>
